# --- GLOBAL ---
PROJECT_NAME=muenchner-kindl-system
NODE_ENV=local

# --- SUPABASE (DOCKER) ---
POSTGRES_PASSWORD=your-super-secret-password
JWT_SECRET=your-jwt-secret
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=http://localhost:54321

# --- WINDMILL ---
WINDMILL_DATABASE_URL=postgres://windmill_user:windmill_pass@db:5432/windmill
WINDMILL_DOMAIN=http://localhost:8000

# --- OLLAMA ---
OLLAMA_API_URL=http://ollama:11434/api
OLLAMA_MODEL=llama3.1:8b

# --- NODE-RED ---
NODE_RED_CREDENTIAL_SECRET=your-node-red-secret

# --- MONITORING ---
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090

# --- BACKUP ---
BACKUP_ENCRYPTION_KEY=your-backup-key
